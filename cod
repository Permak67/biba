import socket
import json
import time
import threading
import cv2
import numpy as np
from datetime import datetime
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

# ================== КОНФИГУРАЦИЯ ==================
TCP_PORT = 8080          # Порт для Wemos
HTTP_PORT = 8000         # Порт для веб-интерфейса
CAMERA_INDEX = 0         # 0 - встроенная камера, 1 - USB камера
CAMERA_WIDTH = 640       # Ширина кадра
CAMERA_HEIGHT = 480      # Высота кадра
CAMERA_FPS = 30          # FPS для камеры

# ================== НАСТРОЙКИ ТРЕКИНГА ==================
TRACKING_MODE = "face"   # "face", "hand", "both"
SERVO_MIN_ANGLE = 0      # Минимальный угол серво
SERVO_MAX_ANGLE = 180    # Максимальный угол серво
SERVO_CENTER = 90        # Центральное положение
SMOOTH_FACTOR = 0.3      # Сглаживание движений (0.1-0.9)
DEAD_ZONE = 20           # Мертвая зона в пикселях
TRACKING_SPEED = 15      # Скорость серво (ms/шаг)

# ================== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ==================
clients = {}            # Подключенные Wemos
commands = {}           # Очередь команд
camera = None           # Объект камеры
camera_active = False   # Статус камеры
tracking_active = False # Статус трекинга
current_servo_angle = 90 # Текущий угол серво
target_servo_angle = 90  # Целевой угол серво

# ================== КЛАСС ДЛЯ РАБОТЫ С КАМЕРОЙ И ТРЕКИНГОМ ==================
class CameraTracker:
    """Управление камерой и отслеживание объектов"""
    
    def __init__(self, src=CAMERA_INDEX):
        self.src = src
        self.cap = None
        self.frame = None
        self.processed_frame = None
        self.running = False
        self.tracking = False
        self.mode = TRACKING_MODE
        
        # Для детекции лиц
        self.face_cascade = None
        self.load_face_cascade()
        
        # Для детекции рук
        self.hand_cascade = None
        self.load_hand_cascade()
        
        # Параметры трекинга
        self.tracked_object = None
        self.tracker = None
        self.tracking_initialized = False
        
        # Сглаживание
        self.smooth_x = CAMERA_WIDTH // 2
        self.smooth_y = CAMERA_HEIGHT // 2
        
        # Статистика
        self.fps = 0
        self.detections = 0
        self.frame_count = 0
        self.last_time = time.time()
        
        # Цвета для отображения
        self.colors = {
            'face': (0, 255, 0),    # Зеленый
            'hand': (0, 0, 255),     # Красный
            'track': (255, 255, 0),  # Желтый
            'center': (255, 0, 0)    # Синий
        }
    
    def load_face_cascade(self):
        """Загрузка каскада Хаара для лиц"""
        try:
            # Пробуем разные пути
            paths = [
                cv2.data.haarcascades + 'haarcascade_frontalface_default.xml',
                'haarcascade_frontalface_default.xml',
                '/usr/share/opencv4/haarcascades/haarcascade_frontalface_default.xml'
            ]
            
            for path in paths:
                self.face_cascade = cv2.CascadeClassifier(path)
                if not self.face_cascade.empty():
                    print(f"✅ Загружен каскад лиц: {path}")
                    return True
            
            print("❌ Не удалось загрузить каскад лиц")
            return False
        except Exception as e:
            print(f"❌ Ошибка загрузки каскада лиц: {e}")
            return False
    
    def load_hand_cascade(self):
        """Создание детектора рук на основе цвета кожи"""
        # Будем использовать HSV цветовое пространство
        self.hand_lower = np.array([0, 30, 60])    # Нижняя граница цвета кожи
        self.hand_upper = np.array([20, 150, 255]) # Верхняя граница цвета кожи
        return True
    
    def start(self):
        """Запуск камеры"""
        global camera_active
        
        print("📸 Запуск камеры...")
        try:
            self.cap = cv2.VideoCapture(self.src)
            
            # Настройка параметров камеры
            self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, CAMERA_WIDTH)
            self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, CAMERA_HEIGHT)
            self.cap.set(cv2.CAP_PROP_FPS, CAMERA_FPS)
            self.cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
            
            if not self.cap.isOpened():
                print("❌ Не удалось открыть камеру!")
                return False
            
            # Проверочный кадр
            ret, test_frame = self.cap.read()
            if not ret:
                print("❌ Не удается получить кадр с камеры!")
                return False
            
            self.running = True
            camera_active = True
            
            print(f"✅ Камера запущена!")
            print(f"   📷 Размер: {CAMERA_WIDTH}x{CAMERA_HEIGHT}")
            print(f"   🎬 FPS: {CAMERA_FPS}")
            print(f"   🎯 Режим: {self.mode}")
            
            # Запускаем поток захвата кадров
            thread = threading.Thread(target=self._capture_loop, daemon=True)
            thread.start()
            
            return True
            
        except Exception as e:
            print(f"❌ Ошибка инициализации камеры: {e}")
            return False
    
    def _capture_loop(self):
        """Основной цикл захвата и обработки кадров"""
        global target_servo_angle, current_servo_angle, tracking_active
        
        while self.running and self.cap and self.cap.isOpened():
            try:
                ret, frame = self.cap.read()
                
                if ret and frame is not None:
                    self.frame_count += 1
                    
                    # Изменяем размер для производительности
                    frame = cv2.resize(frame, (CAMERA_WIDTH, CAMERA_HEIGHT))
                    
                    # Создаем копию для отображения
                    display_frame = frame.copy()
                    
                    # Поиск объектов
                    objects = []
                    
                    if self.mode == "face" or self.mode == "both":
                        faces = self.detect_faces(frame)
                        for (x, y, w, h) in faces:
                            objects.append({
                                'type': 'face',
                                'x': x + w//2,
                                'y': y + h//2,
                                'w': w,
                                'h': h,
                                'bbox': (x, y, w, h)
                            })
                            # Рисуем лицо
                            cv2.rectangle(display_frame, (x, y), (x+w, y+h), self.colors['face'], 2)
                            cv2.putText(display_frame, f"Face {len(faces)}", (x, y-10), 
                                      cv2.FONT_HERSHEY_SIMPLEX, 0.5, self.colors['face'], 2)
                    
                    if self.mode == "hand" or self.mode == "both":
                        hands = self.detect_hands(frame)
                        for (x, y, w, h) in hands:
                            objects.append({
                                'type': 'hand',
                                'x': x + w//2,
                                'y': y + h//2,
                                'w': w,
                                'h': h,
                                'bbox': (x, y, w, h)
                            })
                            # Рисуем руку
                            cv2.rectangle(display_frame, (x, y), (x+w, y+h), self.colors['hand'], 2)
                            cv2.putText(display_frame, f"Hand {len(hands)}", (x, y-10), 
                                      cv2.FONT_HERSHEY_SIMPLEX, 0.5, self.colors['hand'], 2)
                    
                    # Выбираем объект для трекинга (ближайший к центру)
                    if objects and self.tracking:
                        center_x = CAMERA_WIDTH // 2
                        center_y = CAMERA_HEIGHT // 2
                        
                        # Находим объект ближайший к центру
                        closest = min(objects, key=lambda obj: 
                                    abs(obj['x'] - center_x) + abs(obj['y'] - center_y))
                        
                        # Рисуем центр выбранного объекта
                        cv2.circle(display_frame, (closest['x'], closest['y']), 5, self.colors['track'], -1)
                        cv2.circle(display_frame, (closest['x'], closest['y']), 20, self.colors['track'], 2)
                        
                        # Вычисляем целевой угол серво
                        self.calculate_servo_angle(closest['x'])
                        
                        # Добавляем информацию
                        cv2.putText(display_frame, f"Tracking: {closest['type']}", 
                                  (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.7, self.colors['track'], 2)
                    
                    # Рисуем центральную линию
                    cv2.line(display_frame, (CAMERA_WIDTH//2, 0), 
                            (CAMERA_WIDTH//2, CAMERA_HEIGHT), (255, 255, 255), 1)
                    
                    # Рисуем мертвую зону
                    cv2.line(display_frame, (CAMERA_WIDTH//2 - DEAD_ZONE, 0), 
                            (CAMERA_WIDTH//2 - DEAD_ZONE, CAMERA_HEIGHT), (100, 100, 100), 1)
                    cv2.line(display_frame, (CAMERA_WIDTH//2 + DEAD_ZONE, 0), 
                            (CAMERA_WIDTH//2 + DEAD_ZONE, CAMERA_HEIGHT), (100, 100, 100), 1)
                    
                    # Добавляем информацию на кадр
                    self.add_info_to_frame(display_frame)
                    
                    # Конвертируем в JPEG
                    ret, jpeg = cv2.imencode('.jpg', display_frame, 
                                            [cv2.IMWRITE_JPEG_QUALITY, 80])
                    
                    if ret:
                        self.frame = jpeg.tobytes()
                    
                    # Обновляем FPS
                    self.update_fps()
                
                # Контроль FPS
                time.sleep(1.0 / CAMERA_FPS)
                
            except Exception as e:
                print(f"⚠️ Ошибка захвата кадра: {e}")
                time.sleep(0.1)
    
    def detect_faces(self, frame):
        """Детекция лиц"""
        if self.face_cascade is None or self.face_cascade.empty():
            return []
        
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = self.face_cascade.detectMultiScale(
            gray,
            scaleFactor=1.1,
            minNeighbors=5,
            minSize=(30, 30)
        )
        return faces
    
    def detect_hands(self, frame):
        """Детекция рук по цвету кожи"""
        hands = []
        
        # Конвертируем в HSV
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        
        # Создаем маску для цвета кожи
        mask = cv2.inRange(hsv, self.hand_lower, self.hand_upper)
        
        # Убираем шум
        mask = cv2.erode(mask, None, iterations=2)
        mask = cv2.dilate(mask, None, iterations=2)
        
        # Находим контуры
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, 
                                       cv2.CHAIN_APPROX_SIMPLE)
        
        for contour in contours:
            area = cv2.contourArea(contour)
            if area > 1000:  # Минимальная площадь
                x, y, w, h = cv2.boundingRect(contour)
                hands.append((x, y, w, h))
        
        return hands
    
    def calculate_servo_angle(self, object_x):
        """Вычисление угла серво на основе позиции объекта"""
        global target_servo_angle, current_servo_angle
        
        if not self.tracking:
            return
        
        # Нормализуем позицию от 0 до 1
        normalized_x = object_x / CAMERA_WIDTH
        
        # Преобразуем в угол серво
        target_angle = SERVO_MIN_ANGLE + normalized_x * (SERVO_MAX_ANGLE - SERVO_MIN_ANGLE)
        
        # Проверяем мертвую зону
        center_x = CAMERA_WIDTH // 2
        if abs(object_x - center_x) < DEAD_ZONE:
            target_angle = SERVO_CENTER
        
        # Ограничиваем угол
        target_angle = max(SERVO_MIN_ANGLE, min(SERVO_MAX_ANGLE, target_angle))
        
        # Сглаживание движения
        self.smooth_x = self.smooth_x * (1 - SMOOTH_FACTOR) + target_angle * SMOOTH_FACTOR
        
        target_servo_angle = int(self.smooth_x)
    
    def add_info_to_frame(self, frame):
        """Добавление информации на кадр"""
        # Режим трекинга
        mode_text = f"Mode: {self.mode.upper()}"
        cv2.putText(frame, mode_text, (10, 30), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        
        # Статус трекинга
        tracking_text = f"Tracking: {'ON' if self.tracking else 'OFF'}"
        color = (0, 255, 0) if self.tracking else (0, 0, 255)
        cv2.putText(frame, tracking_text, (10, 90), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)
        
        # Угол серво
        cv2.putText(frame, f"Servo: {target_servo_angle}°", 
                   (10, 120), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)
        
        # FPS
        cv2.putText(frame, f"FPS: {self.fps:.1f}", 
                   (10, 150), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        
        # Детекции
        cv2.putText(frame, f"Detections: {self.detections}", 
                   (10, 180), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        
        # Время
        time_text = datetime.now().strftime('%H:%M:%S')
        cv2.putText(frame, time_text, 
                   (CAMERA_WIDTH - 150, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    
    def update_fps(self):
        """Обновление FPS"""
        self.fps += 1
        current_time = time.time()
        if current_time - self.last_time >= 1.0:
            self.fps = self.fps / (current_time - self.last_time)
            self.last_time = current_time
            self.fps = 0
    
    def get_frame(self):
        """Получение последнего кадра"""
        return self.frame
    
    def set_mode(self, mode):
        """Установка режима трекинга"""
        if mode in ["face", "hand", "both", "off"]:
            self.mode = mode
            self.tracking = (mode != "off")
            return True
        return False
    
    def stop(self):
        """Остановка камеры"""
        global camera_active, tracking_active
        
        self.running = False
        camera_active = False
        tracking_active = False
        
        if self.cap:
            self.cap.release()
        
        print("📸 Камера остановлена")
    
    def get_status(self):
        """Статус камеры и трекинга"""
        return {
            'active': self.running,
            'tracking': self.tracking,
            'mode': self.mode,
            'servo_angle': target_servo_angle,
            'fps': self.fps,
            'detections': self.detections,
            'width': CAMERA_WIDTH,
            'height': CAMERA_HEIGHT
        }

# ================== TCP СЕРВЕР ДЛЯ WEMOS ==================
def tcp_server():
    """TCP сервер для приема данных от Wemos"""
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(('0.0.0.0', TCP_PORT))
    server.listen(5)
    
    print(f"✅ TCP сервер запущен на порту {TCP_PORT}")
    
    while True:
        try:
            client, addr = server.accept()
            print(f"🔌 Wemos подключен: {addr}")
            threading.Thread(target=handle_wemos, args=(client, addr), daemon=True).start()
        except Exception as e:
            print(f"⚠️ TCP ошибка: {e}")
            time.sleep(1)

def handle_wemos(client_sock, addr):
    """Обработка подключения Wemos"""
    device_id = f"wemos_{addr[0]}"
    
    try:
        client_sock.settimeout(30)
        
        while True:
            data = client_sock.recv(1024)
            if not data:
                break
            
            text = data.decode('utf-8', errors='ignore').strip()
            
            if text:
                print(f"📥 Wemos {addr[0]}: {text[:50]}...")
                
                # Обновляем данные клиента
                clients[device_id] = {
                    'socket': client_sock,
                    'addr': addr[0],
                    'last_seen': time.time(),
                    'online': True
                }
                
                # Парсим JSON данные
                try:
                    if text.startswith('{'):
                        json_data = json.loads(text)
                        if 'cooler' in json_data:
                            clients[device_id]['cooler'] = json_data['cooler']
                        if 'servo' in json_data:
                            clients[device_id]['servo'] = json_data['servo']
                except:
                    pass
                
                # Отправляем команду если есть
                if device_id in commands and commands[device_id]:
                    cmd = commands[device_id].pop(0)
                    client_sock.send(json.dumps(cmd).encode() + b'\n')
                    print(f"📤 Wemos {addr[0]}: {cmd}")
            
    except Exception as e:
        print(f"⚠️ Ошибка Wemos {addr}: {e}")
    finally:
        client_sock.close()
        if device_id in clients:
            clients[device_id]['online'] = False
            print(f"📴 Wemos отключен: {addr}")

# ================== HTTP СЕРВЕР ==================
class TrackingHandler(BaseHTTPRequestHandler):
    """HTTP обработчик с трекингом"""
    
    def send_html(self, content):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
        self.end_headers()
        self.wfile.write(content.encode('utf-8'))
    
    def send_jpeg(self, jpeg_data):
        self.send_response(200)
        self.send_header('Content-Type', 'image/jpeg')
        self.send_header('Content-Length', str(len(jpeg_data)))
        self.send_header('Cache-Control', 'no-cache, no-store, must-revalidate')
        self.end_headers()
        self.wfile.write(jpeg_data)
    
    def send_json(self, data):
        self.send_response(200)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.end_headers()
        self.wfile.write(json.dumps(data, ensure_ascii=False).encode('utf-8'))
    
    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)
        
        try:
            if path == '/':
                self.send_main_page()
            elif path == '/video_feed':
                self.send_video_feed()
            elif path == '/camera_status':
                self.send_camera_status()
            elif path == '/clients':
                self.send_clients()
            elif path == '/cmd':
                self.handle_command(query)
            elif path == '/tracking':
                self.handle_tracking(query)
            elif path == '/status':
                self.send_server_status()
            else:
                self.send_error(404)
                
        except Exception as e:
            print(f"❌ HTTP ошибка: {e}")
            self.send_error(500)
    
