    <script>
        // ================== ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ==================
        let trackingActive = true;
        let currentMode = '{TRACKING_MODE}';
        let servoSpeed = 15;
        let deadZone = 20;
        let smoothFactor = 0.3;
        
        // ================== УПРАВЛЕНИЕ ТРЕКИНГОМ ==================
        function setMode(mode) {{
            currentMode = mode;
            
            // Обновляем кнопки
            document.querySelectorAll('.mode-buttons .btn').forEach(btn => {{
                btn.classList.remove('active');
            }});
            document.getElementById(`mode${{mode.charAt(0).toUpperCase() + mode.slice(1)}}`).classList.add('active');
            
            // Отправляем на сервер
            fetch(`/tracking?action=mode&mode=${{mode}}`)
                .then(r => r.json())
                .then(data => {{
                    addLog(`🎯 Режим изменен: ${{mode}}`);
                    document.getElementById('currentMode').innerHTML = mode.toUpperCase();
                }});
        }}
        
        function setServoSpeed(speed) {{
            servoSpeed = speed;
            document.getElementById('servoSpeed').innerHTML = speed;
            
            fetch(`/tracking?action=speed&value=${{speed}}`)
                .then(r => r.json())
                .then(data => addLog(`⚡ Скорость серво: ${{speed}}ms`));
        }}
        
        function setDeadZone(value) {{
            deadZone = value;
            document.getElementById('deadZone').innerHTML = value;
            
            fetch(`/tracking?action=deadzone&value=${{value}}`)
                .then(r => r.json())
                .then(data => addLog(`🎯 Мертвая зона: ${{value}}px`));
        }}
        
        function setSmoothFactor(value) {{
            smoothFactor = value;
            document.getElementById('smoothFactor').innerHTML = value;
            
            fetch(`/tracking?action=smooth&value=${{value}}`)
                .then(r => r.json())
                .then(data => addLog(`✨ Сглаживание: ${{value}}`));
        }}
        
        // ================== УПРАВЛЕНИЕ КУЛЕРОМ ==================
        function setCooler(value) {{
            fetch(`/cmd?cmd=cooler&val=${{value}}`)
                .then(r => r.text())
                .then(text => addLog(`🌀 Кулер: ${{value}} (${{Math.round(value/10.23)}}%)`));
        }}
        
        function updateCooler(value) {{
            setCooler(value);
        }}
        
        // ================== АВАРИЙНЫЙ СТОП ==================
        function emergencyStop() {{
            fetch(`/cmd?cmd=stop&val=0`)
                .then(r => r.text())
                .then(text => {{
                    addLog(`🛑 АВАРИЙНЫЙ СТОП!`);
                    document.getElementById('coolerSlider').value = 0;
                }});
        }}
        
        // ================== ОБНОВЛЕНИЕ СТАТУСА ==================
        function updateStatus() {{
            fetch('/camera_status')
                .then(r => r.json())
                .then(data => {{
                    document.getElementById('servoAngle').innerHTML = data.servo_angle + '°';
                    document.getElementById('fpsValue').innerHTML = Math.round(data.fps);
                    document.getElementById('currentMode').innerHTML = data.mode.toUpperCase();
                    document.getElementById('trackingStatus').innerHTML = data.tracking ? '🎯 Трекинг ON' : '⏹️ Трекинг OFF';
                    
                    // Обновляем позицию серво
                    const servoPos = (data.servo_angle / 180) * 100;
                    document.getElementById('servoPosition').style.left = servoPos + '%';
                    
                    // Обновляем кнопку режима
                    document.querySelectorAll('.mode-buttons .btn').forEach(btn => {{
                        btn.classList.remove('active');
                    }});
                    if (document.getElementById(`mode${{data.mode.charAt(0).toUpperCase() + data.mode.slice(1)}}`)) {{
                        document.getElementById(`mode${{data.mode.charAt(0).toUpperCase() + data.mode.slice(1)}}`).classList.add('active');
                    }}
                }});
        }}
        
        function updateDevices() {{
            fetch('/clients')
                .then(r => r.json())
                .then(devices => {{
                    const container = document.getElementById('devicesList');
                    
                    if (devices.length === 0) {{
                        container.innerHTML = '<div class="device-card offline"><div style="text-align: center; padding: 20px;">⚠️ Нет подключенных устройств</div></div>';
                        return;
                    }}
                    
                    let html = '';
                    devices.forEach(device => {{
                        const statusClass = device.online ? 'online' : 'offline';
                        const statusText = device.online ? '🟢 Онлайн' : '🔴 Офлайн';
                        
                        html += `
                            <div class="device-card ${{statusClass}}">
                                <div style="display: flex; justify-content: space-between;">
                                    <strong>🔧 ${{device.id}}</strong>
                                    <span>${{statusText}}</span>
                                </div>
                                <div style="margin-top: 10px;">
                                    <div>🌀 Кулер: ${{device.cooler || 0}} (${{Math.round((device.cooler||0)/10.23)}}%)</div>
                                    <div>🔄 Серво: ${{device.servo || 90}}°</div>
                                    <div>📶 RSSI: ${{device.rssi || 0}} dBm</div>
                                    <div style="font-size: 12px; color: #aaa;">📍 ${{device.ip}} | ⏰ ${{device.last_seen}}</div>
                                </div>
                            </div>
                        `;
                    }});
                    
                    container.innerHTML = html;
                }});
        }}
        
        // ================== ЛОГИРОВАНИЕ ==================
        function addLog(message) {{
            console.log(message);
        }}
        
        // ================== ОБНОВЛЕНИЕ КАДРА ==================
        function updateVideo() {{
            const img = document.getElementById('videoFeed');
            img.src = '/video_feed?t=' + Date.now();
            document.getElementById('cameraTime').innerHTML = new Date().toLocaleTimeString();
        }}
        
        // ================== ИНИЦИАЛИЗАЦИЯ ==================
        window.onload = function() {{
            setMode(currentMode);
            
            // Автообновление
            setInterval(updateStatus, 100);
            setInterval(updateDevices, 2000);
            setInterval(updateVideo, 66);
            
            addLog('🚀 Система трекинга запущена');
        }};
    </script>
</body>
</html>'''
        
        self.send_html(html)
    
    def send_video_feed(self):
        """Отправка видеопотока"""
        global camera
        
        if camera and camera.frame:
            self.send_jpeg(camera.frame)
        else:
            # Создаем черный кадр
            black = np.zeros((CAMERA_HEIGHT, CAMERA_WIDTH, 3), dtype=np.uint8)
            cv2.putText(black, "Camera not available", (50, 240), 
                       cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 2)
            ret, jpeg = cv2.imencode('.jpg', black)
            self.send_jpeg(jpeg.tobytes())
    
    def send_camera_status(self):
        """Статус камеры и трекинга"""
        global camera, target_servo_angle
        
        if camera:
            status = camera.get_status()
            status['servo_angle'] = target_servo_angle
        else:
            status = {
                'active': False,
                'tracking': False,
                'mode': 'off',
                'servo_angle': 90,
                'fps': 0,
                'detections': 0
            }
        
        self.send_json(status)
    
    def send_clients(self):
        """Список подключенных Wemos"""
        client_list = []
        current_time = time.time()
        
        for device_id, data in clients.items():
            client_list.append({
                'id': device_id,
                'ip': data.get('addr', 'unknown'),
                'cooler': data.get('cooler', 0),
                'servo': data.get('servo', 90),
                'rssi': data.get('rssi', -70),
                'last_seen': time.strftime('%H:%M:%S', time.localtime(data.get('last_seen', 0))),
                'online': current_time - data.get('last_seen', 0) < 30
            })
        
        self.send_json(client_list)
    
    def handle_command(self, query):
        """Отправка команды Wemos"""
        global target_servo_angle
        
        cmd = query.get('cmd', [''])[0]
        val = query.get('val', ['0'])[0]
        
        try:
            val = int(val)
        except:
            val = 0
        
        # Если это команда серво от трекинга
        if cmd == 'servo_track':
            val = target_servo_angle
        
        # Создаем команду
        command = {'cmd': 'servo' if cmd == 'servo_track' else cmd, 'val': val, 'time': time.time()}
        
        # Отправляем всем подключенным Wemos
        sent = 0
        for device_id, data in clients.items():
            if 'socket' in data and data.get('online', False):
                try:
                    data['socket'].send(json.dumps(command).encode() + b'\n')
                    sent += 1
                except:
                    pass
        
        self.send_response(200)
        self.send_header('Content-Type', 'text/plain; charset=utf-8')
        self.end_headers()
        self.wfile.write(f"Команда отправлена {sent} устройствам".encode('utf-8'))
    
    def handle_tracking(self, query):
        """Управление трекингом"""
        global camera, SMOOTH_FACTOR, DEAD_ZONE, TRACKING_SPEED
        
        action = query.get('action', [''])[0]
        
        if action == 'mode':
            mode = query.get('mode', ['off'])[0]
            if camera:
                camera.set_mode(mode)
            self.send_json({'status': 'ok', 'mode': mode})
        
        elif action == 'speed':
            speed = query.get('value', ['15'])[0]
            try:
                TRACKING_SPEED = int(speed)
                self.send_json({'status': 'ok', 'speed': TRACKING_SPEED})
            except:
                self.send_json({'status': 'error'})
        
        elif action == 'deadzone':
            zone = query.get('value', ['20'])[0]
            try:
                DEAD_ZONE = int(zone)
                self.send_json({'status': 'ok', 'deadzone': DEAD_ZONE})
            except:
                self.send_json({'status': 'error'})
        
        elif action == 'smooth':
            smooth = query.get('value', ['0.3'])[0]
            try:
                SMOOTH_FACTOR = float(smooth)
                self.send_json({'status': 'ok', 'smooth': SMOOTH_FACTOR})
            except:
                self.send_json({'status': 'error'})
        
        else:
            self.send_json({'status': 'unknown_command'})
    
    def send_server_status(self):
        """Статус сервера"""
        try:
            temp_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            temp_socket.connect(('8.8.8.8', 80))
            local_ip = temp_socket.getsockname()[0]
            temp_socket.close()
        except:
            local_ip = '127.0.0.1'
        
        status = {
            'status': 'running',
            'ip': local_ip,
            'http_port': HTTP_PORT,
            'tcp_port': TCP_PORT,
            'clients': len(clients),
            'time': time.time()
        }
        
        self.send_json(status)

# ================== ОСНОВНАЯ ПРОГРАММА ==================
def main():
    """Запуск сервера"""
    global camera
    
    print("\n" + "="*60)
    print("🚀 ЗАПУСК СЕРВЕРА WEMOS + FACE/HAND TRACKING")
    print("="*60 + "\n")
    
    # Получаем локальный IP
    try:
        temp_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        temp_socket.connect(('8.8.8.8', 80))
        local_ip = temp_socket.getsockname()[0]
        temp_socket.close()
    except:
        local_ip = '127.0.0.1'
    
    print(f"📍 IP адрес сервера: {local_ip}")
    print(f"📡 TCP порт (Wemos): {TCP_PORT}")
    print(f"🌐 HTTP порт (сайт): {HTTP_PORT}")
    print(f"🎯 Режим трекинга: {TRACKING_MODE}")
    print("\n" + "-"*60)
    
    # Запускаем камеру с трекингом
    print("\n📸 Инициализация камеры с трекингом...")
    camera = CameraTracker()
    if camera.start():
        print("✅ Камера готова к работе")
    else:
        print("⚠️ Камера не доступна, работаем без видео")
    
    print("\n" + "-"*60)
    print("\n🚀 Запуск серверов...")
    
    # Запускаем TCP сервер для Wemos
    tcp_thread = threading.Thread(target=tcp_server, daemon=True)
    tcp_thread.start()
    print("✅ TCP сервер запущен")
    
    # Запускаем поток отправки команд серво
    def send_servo_commands():
        """Отправка команд серво на Wemos"""
        global target_servo_angle
        
        while True:
            if camera and camera.tracking:
                # Отправляем команду серво
                for device_id, data in clients.items():
                    if 'socket' in data and data.get('online', False):
                        try:
                            command = {'cmd': 'servo', 'val': target_servo_angle}
                            data['socket'].send(json.dumps(command).encode() + b'\n')
                        except:
                            pass
            
            time.sleep(TRACKING_SPEED / 1000.0)
    
    servo_thread = threading.Thread(target=send_servo_commands, daemon=True)
    servo_thread.start()
    
    # Запускаем HTTP сервер
    try:
        http_server = HTTPServer(('0.0.0.0', HTTP_PORT), TrackingHandler)
        print(f"✅ HTTP сервер запущен на порту {HTTP_PORT}")
        print(f"\n🌐 Откройте в браузере: http://{local_ip}:{HTTP_PORT}")
        print("\n" + "="*60)
        print("⚡ Сервер работает. Нажмите Ctrl+C для остановки")
        print("="*60 + "\n")
        
        http_server.serve_forever()
        
    except KeyboardInterrupt:
        print("\n\n🛑 Сервер остановлен пользователем")
    except Exception as e:
        print(f"\n❌ Ошибка: {e}")
    finally:
        if camera:
            camera.stop()

if __name__ == '__main__':
    main()
